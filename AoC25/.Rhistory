sp <- 50
zh <- 0
for (i in 1:length(ip)){
a <- str_extract(ip[i],"[:alpha:]")
n <- as.numeric(str_extract(ip[i],"[:digit:]+"))
n <- n - ((n %/% 100) * 100)
zh <- zh + (n %/% 100)
if (a == "L"){
sp <- sp - n
} else {
sp <- sp + n
if (sp == 0){
zh <- zh + 1
}
}
if (sp > 99){
sp <- sp - 100
if (sp != 0){
zh <- zh + 1
}
} else if (sp < 0){
sp <- sp + 100
zh <- zh + 1
}
print(paste("i:",i,"sp:",sp,"zh:",zh))
}
