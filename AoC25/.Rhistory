ip <- str_split_1(ip, ",")
iid <- 0
for (i in 1:length(ip)){
for (r in str_extract(ip[i], "[:digit:]+(?=-)"):str_extract(ip[i], "(?<=-)[:digit:]+")){
if (length(r) %% 2 == 0){
if (str_sub(r, start = 1, end = (str_length(r)/2)) == str_sub(r, start = (str_length(r)/2)+1, end = str_length(r))){
iid <- iid + r
}
}
}
}
